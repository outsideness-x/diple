<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- See the note in `diple/diple-macos.entitlements`: sandboxed, and the App Group named
	     the way macOS requires. The extension writes one small JSON file into the group and
	     opens nothing else. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.chemical-pink.diple</string>
		<string>group.com.chemical-pink.diple</string>
	</array>
</dict>
</plist>
