<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>diple.</string>
	<!-- Declared here rather than answered by hand on every upload, which otherwise parks
	     each build in "Missing Compliance". The app's only cryptography is HTTPS through the
	     system stack when importing an article and CloudKit's own transport, both exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- No UIUserInterfaceStyle here on purpose. It used to be pinned to Dark, which was
	     right while the app had one appearance: it kept the launch screen, system sheets and
	     the keyboard from following a light device. It is also an app-wide override, so with
	     it in place the reader's own Appearance setting could not produce a light interface at
	     all. The setting now drives the window instead. -->
	<!-- Painted with the app's own canvas rather than the system background: `canvas` is
	     deliberately #0B0B0F on dark and a soft grey on light (see CLAUDE.md), so the generated
	     launch screen would still have stepped one shade on the way in. The asset carries both
	     appearances. It follows the *device*, not the in-app setting — nothing of ours runs
	     before it — so choosing Dark on a light phone still shows one light frame at launch. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
